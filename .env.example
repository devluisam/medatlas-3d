# Banco de dados PostgreSQL (Prisma)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/medatlas"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/medatlas"

# OpenAI — usado no tutor de IA e na geracao de questoes
OPENAI_API_KEY="sua-chave-aqui"

# Autenticacao (NextAuth v5)
# Gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="gere-uma-chave-aleatoria"
# Em producao, a URL publica da aplicacao
AUTH_URL="http://localhost:3000"

# Login com Google (opcional) — sem estas duas variaveis
# o botao do Google nao aparece na tela de login
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
